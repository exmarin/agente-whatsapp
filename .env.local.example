# Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. AES-256-GCM key used by src/lib/crypto.ts to encrypt/decrypt
# per-workspace integration credentials (YCloud/OpenRouter/HighLevel) before
# they're stored in Postgres. NEVER stored in the DB (SEC-03). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Server-only. HMAC secret shared between pg_cron and the internal buffer
# worker endpoint (/api/internal/buffer/process). Not used until Fase 2.
INTERNAL_BUFFER_SECRET=

# Server-only. HighLevel Marketplace App OAuth client (one per app, not per
# workspace — the resulting per-workspace access/refresh tokens are stored
# encrypted in `integrations.oauth_tokens`). Not used until Fase 5.
HL_CLIENT_ID=
HL_CLIENT_SECRET=
HL_REDIRECT_URI=

# NOTE: YCloud API key/webhook signing secret and the OpenRouter API key are
# NOT global env vars in this design — each workspace connects its own via
# Settings → Integrations, encrypted into `integrations.credentials`
# (see docs/planeacion/BLUEPRINT-agente-whatsapp.md §3.8/§5). Don't add
# YCLOUD_API_KEY / OPENROUTER_API_KEY here as a shortcut.

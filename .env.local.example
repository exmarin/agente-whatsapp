# Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. AES-256-GCM key used by src/lib/crypto.ts to encrypt/decrypt
# per-workspace integration credentials (Meta/OpenRouter/HighLevel) before
# they're stored in Postgres. NEVER stored in the DB (SEC-03). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Server-only. HMAC secret shared between pg_cron and the internal buffer
# worker endpoint (/api/internal/buffer/process). Not used until Fase 2.
INTERNAL_BUFFER_SECRET=

# Server-only. Meta WhatsApp Cloud API — one Meta App for the whole
# deployment (not per workspace). App Secret verifies X-Hub-Signature-256 on
# every webhook POST (Meta App dashboard → Settings → Basic). Verify Token is
# a string YOU pick and register in the same webhook config; Meta echoes it
# back on the one-time GET subscription challenge. Each workspace's own
# access token + phone_number_id are connected via Settings → Integrations,
# encrypted into `integrations.credentials`/`config` — don't add a global
# META_ACCESS_TOKEN here.
META_APP_SECRET=
META_VERIFY_TOKEN=
# Optional, defaults to v21.0 if unset.
META_GRAPH_API_VERSION=

# Server-only. Resend (resend.com) — one global account for the whole
# deployment, used to notify a workspace's team by email (new customer /
# AI paused). Free tier: 3,000 emails/month. Sends from the sandbox address
# onboarding@resend.dev until a workspace verifies its own sending domain.
RESEND_API_KEY=

# Server-only. HighLevel Marketplace App OAuth client (one per app, not per
# workspace — the resulting per-workspace access/refresh tokens are stored
# encrypted in `integrations.oauth_tokens`). Not used until Fase 5.
HL_CLIENT_ID=
HL_CLIENT_SECRET=
HL_REDIRECT_URI=

# NOTE: per-workspace Meta access token/phone_number_id and the OpenRouter
# API key are NOT global env vars in this design — each workspace connects
# its own via Settings → Integrations, encrypted into
# `integrations.credentials`/`config`. Don't add OPENROUTER_API_KEY or a
# global Meta access token here as a shortcut.
